<Project Sdk="Microsoft.NET.Sdk.Web">

	<Target Name="CreatePublishArchive" AfterTargets="Publish" Condition="'$(PublishArchive)' != 'false'">
		<PropertyGroup>
			<_ArchiveRid Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '*'">-$(RuntimeIdentifier)</_ArchiveRid>
			<_PublishArchiveDir>$(MSBuildProjectDirectory)/publish</_PublishArchiveDir>
			<_PublishArchivePath>$(_PublishArchiveDir)/$(AssemblyName)-v$(Version)$(_ArchiveRid).zip</_PublishArchivePath>
		</PropertyGroup>

		<Message Text="====================================================" Importance="high" />
		<Message Text="CREATING PUBLISH ARCHIVE..." Importance="high" />
		<Message Text="====================================================" Importance="high" />

		<MakeDir Directories="$(_PublishArchiveDir)" />
		<Delete Files="$(_PublishArchivePath)" Condition="Exists($(_PublishArchivePath))" />
		<ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_PublishArchivePath)" />

		<Message Text="Publish archive created: $(_PublishArchivePath)" Importance="high" />
	</Target>

	<Target Name="PublishVueApp" BeforeTargets="ComputeFilesToPublish">
		<PropertyGroup>
			<VueAppDir>../dashboard/</VueAppDir>
		</PropertyGroup>

		<Message Text="====================================================" Importance="high" />
		<Message Text="BUILDING VUE APP BEFORE PUBLISH..." Importance="high" />
		<Message Text="====================================================" Importance="high" />
		
		<Exec Command="npm install --loglevel=error" WorkingDirectory="$(VueAppDir)" Condition="!Exists('$(VueAppDir)node_modules')" />

		<Exec Command="npm run build" WorkingDirectory="$(VueAppDir)" />
	</Target>
	
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <Authors>Vitaly Yakovlev (optinosft)</Authors>
    <Copyright>Vitaly Yakovlev, vitaly@optinosft.net</Copyright>
    <Description>Proxy mapping service: routes traffic through external proxy servers or bypasses them, with optional SSL decryption, per-port and per-host SSL/TLS options overrides, browser-like TLS fingerprints (Chrome/Firefox), response caching, HTTP/1.1 pipelining, HTTP/2 and WebSocket support, host blocking rules and a web dashboard.</Description>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'http' " />

  <ItemGroup>
    <PackageReference Include="Fare" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.25" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <Import Project="local.props"
    Condition="Exists('local.props')" />

  <ItemGroup Condition="'$(UseLocalProjects)' == 'true'">
    <ProjectReference Include="..\..\BoringSslStream\BoringSslStream\BoringSslStream.csproj" />
    <ProjectReference Include="..\..\NssStream\NssStream\NssStream.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalProjects)' != 'true'">
	<PackageReference Include="BoringSslStream" Version="1.0.6" />
	<PackageReference Include="NssStream" Version="1.0.7" />
  </ItemGroup>
	
	<ItemGroup>
		<Content Update="appsettings.Development*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<Content Update="*-rules.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<Content Update="*-servers.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

</Project>
