{
    "Logging": {
        "LogLevel": {
            "ProxySession": "Debug"
        },
        "Console": {
            "FormatterName": "simple",
            "FormatterOptions": {
                "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] ",
                "UseUtcTimestamp": true
            }
        },
        "_EventLog": {
            "LogLevel": {
                "Default": "Information"
            }
        }
    },
    "WebSocketMonitoring": {
        "EventLog": {
            "Enabled": true,
            "Capture": false    
        },
        "TrafficMonitor": {
            "Enabled": true,
            "LogBody": true,
            "Capture": false
        }
    },
    "Authentication": {
        "Jwt": {
            "Enabled": false,
            "Issuer": "vue1.qrshow.org",
            "Audience": "rpcauth",
            "Key": "Your_32-character_secret_JWT_key"
        }
    },
    "ProxyMappings": [
        {
            "Listen": {
                "Port": 5001,
                "RejectHttpProxy": false,
                "Action": "Bypass",
                "DecryptSSL": true,
                "IgnoreCertificateErrors": false,
                "StickyProxyLifetime": 10
            },
            "Authentication": {
                "Required": false,
                "Verify": false,
                "SetAuthentication": false
            },
            "ProxyServers": {
                "Items": [
                    {
                        "Host": "192.168.1.204",
                        "Port": 1083,
                        "ProxyType": "Socks5"
                    }
                ]
            }
        }
    ],
    "HostRules": {
        "Items": [
        ]
    },
    "HostStats": {
        "Enabled": true,
        "TrafficStats": true
    },
    "DetailedLogging": {
        "LogReading": false,
        "LogSending": false,
        "LogTrafficData": false,
        "LogSslEncodedData": false,
        "LogSslDecodedData": false,
        "LogHttpRequestHeaders": false,
        "LogHttpResponseHeaders": false,
        "LogStep": false
    },
    "HTTP": {
        "UserAgent": "proxymapper",
        "EnableTranslateH1ToH2": true,
        "DisableDowngradeToHttp1ForCache": false,
        "DisableDowngradeToHttp1ForOverwrittenHost": false
    },
    "SslClientOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "CheckCertificateRevocation": false,
        "ApplicationProtocols": "http/1.1,h2",
        "TrustedCAs": [
            {
                "PemFile": "~/.proxymap/ProxyMapService-Test-ca-cert.pem"
            }
        ]
    },
    "SslServerOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "ClientCertificateRequired": false,
        "CheckCertificateRevocation": false,
        "ApplicationProtocols": "http/1.1,h2",
        "CACertificate": {
			"Path": "~/.proxymap/ProxyMapService-ca.p12"
        }
    },
    "Cache": {
        "Enabled": true,
        "DbPath": "./cache/proxymap.db",
        "CacheDir": "./cache/files"
    },
    "SessionAPI": {
        "Enabled": true,
        "WebSocketsEnabled": true,
        "Domain": "proxymapper"
    }
}
