{
    "WebSocketMonitoring": {
        "EventLog": {
            "Enabled": false
        },
        "TrafficMonitor": {
            "Enabled": false
        }
    },
    "CorsSettings": {
        "AllowedOrigins": [
            "http://localhost:5173",
            "http://localhost",
            "http://localhost/ProxyMapDashboard"
        ]
    },
    "Authentication": {
        "Jwt": {
            "Enabled": true,
            "Issuer": "your_issuer",
            "Audience": "your_audience",
            "Key": "Your_32-character_secret_JWT_key"
        },
        "DevToken": {
            "Enabled": false
        }
    },
    "Dashboard": {
        "Enabled": false
    },
    "Routing": {
        "RoutePrefix": ""
    },

    "HTTP": {
        "UserAgent": "proxymapper",
        "EnableTranslateH1ToH2": true,
        "DisableDowngradeToHttp1ForCache": false,
        "EnableDowngradeToHttp1ForOverwrittenHost": false
    },
    "SslClientOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "CheckCertificateRevocation": true,
        "ApplicationProtocols": "http/1.1,h2",
        "TlsClientType": "Native"
    },
    "SslServerOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "ClientCertificateRequired": false,
        "CheckCertificateRevocation": true,
        "ApplicationProtocols": "http/1.1,h2",
        "CACertificate": {
            "StoreLocation": "LocalMachine",
            "StoreName": "My",
            "Subject": "CN=DO_NOT_TRUST_ProxyMapRoot"
        }
    },
    "Cache": {
        "Enabled": true,
        "DbPath": "c:\\temp\\debug-cache\\proxymap.db",
        "CacheDir": "c:\\temp\\debug-cache\\files"
    }
}
