{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "ProxyService": "Information",
            "ProxySession": "Information"
        },
        "Console": {
            "FormatterName": "simple",
            "FormatterOptions": {
                "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] ",
                "UseUtcTimestamp": true
            }
        },
        "WebSocket": {
            "LogLevel": {
                "Default": "Information",
                "ProxyMapService": "Information",
                "ProxySession": "Information",
                "DevTokenLauncher": "None",
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Cors": "Warning",
                "Microsoft.AspNetCore.SignalR": "Warning",
                "Microsoft.AspNetCore.StaticFiles.StaticFileMiddleware": "Warning",
                "Microsoft.AspNetCore.Authentication.AuthenticationService": "Warning"
            }
        }
    },
    "WebSocketMonitoring": {
        "EventLog": {
            "Enabled": true,
            "MaxEntries": 500,
            "Capture": false
        },
        "TrafficMonitor": {
            "Enabled": true,
            "MaxEntries": 500,
            "LogBody": true,
            "Capture": false
        },
        "QueueCapacity": 10000
    },
    "AllowedHosts": "*",
    "CorsSettings": {
        "AllowedOrigins": [
            "http://localhost:5173"
        ]
    },
    "Security": {
        "AllowOnlyLocalhost": true
    },
    "Authentication": {
        "Jwt": {
            "Enabled": false,
            "Issuer": "your_issuer",
            "Audience": "your_audience",
            "Key": "Your_32-character_secret_JWT_key"
        },
        "DevToken": {
            "Enabled": true
        }
    },
    "Dashboard": {
        "Enabled": true
    },
    "Routing": {
        "RoutePrefix": "/ProxyMapService"
    },
    "HostStats": {
        "Enabled": false,
        "TrafficStats": false
    },
    "DetailedLogging": {
        "LogReading": false,
        "LogSending": false,
        "LogTrafficData": false,
        "LogSslEncodedData": false,
        "LogSslDecodedData": false,
        "LogHttpRequestHeaders": false,
        "LogHttpResponseHeaders": false,
        "LogStep": false,
        "Http2Logging": false,
        "LogConnections": false,
        "LogTlsHandshake": false,
        "LogSniSplitDetails": false,
        "LogProtocolSwitch": false,
        "LogResponseSource": false
    },
    "ProxyMappings": [
        {
            "Listen": {
                "Port": 5001,
                "IPAddress": "Loopback",
                "RejectHttpProxy": false,
                "Action": "Bypass",
                "DecryptSSL": false,
                "IgnoreCertificateErrors": false,
                "StickyProxyLifetime": 10
            },
            "Authentication": {
                "Required": false,
                "Verify": false,
                "SetAuthentication": false
            },
            "ProxyServers": {
                "Items": [
                ]
            }
        }
    ],
    "HTTP": {
        "UserAgent": "proxymapper",
        "EnableTranslateH1ToH2": true,
        "DisableDowngradeToHttp1ForCache": false,
        "EnableDowngradeToHttp1ForOverwrittenHost": false
    },
    "TlsDetection": {
        "ClientHelloPeekTimeoutMs": 500
    },
    "SslClientOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "CheckCertificateRevocation": true,
        "ApplicationProtocols": "http/1.1,h2",
        "TlsClientType": "Auto"
    },
    "SslServerOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "ClientCertificateRequired": false,
        "CheckCertificateRevocation": true,
        "ApplicationProtocols": "http/1.1,h2",
        "CACertificate": {
            "Path": "~/.proxymap/ProxyMapService-ca.p12"
        }
    },
    "Cache": {
        "Enabled": false,
        "DbPath": "./cache/proxymap.db",
        "CacheDir": "./cache/files"
    },
    "SessionAPI": {
        "Enabled": false,
        "WebSocketsEnabled": false,
        "Domain": "proxymapper"
    }
}
