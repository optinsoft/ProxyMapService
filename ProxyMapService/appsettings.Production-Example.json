{
    "ProxyMappings": [
        {
            "Listen": {
                "Port": 5001,
                "RejectHttpProxy": false,
                "StickyProxyLifetime": 0,
                "Action": "Bypass",
                "DecryptSSL": false,
                "IgnoreCertificateErrors": false,
                "SslMode": "Auto",
                "UpstreamSslMode": "Auto",
                "EnableTranslateH1ToH2": true,
                "DisableDowngradeToHttp1ForCache": false,
                "EnableDowngradeToHttp1ForOverwrittenHost": false,
                "IgnoreHostRules": false,
                "SslClientOptions": {
                    "ApplicationProtocols": "http/1.1,h2"
                },
                "SslServerOptions": {
                    "EnabledSslProtocols": "Tls12,Tls13"
                }
            },
            "Authentication": {
                "Required": false,
                "Verify": false,
                "SetAuthentication": false,
                "RemoveAuthentication": false,
                "ParseUsernameParameters": false,
                "Username": "user",
                "Password": "pass"
            }
        }
    ],
    "HTTP": {
        "UserAgent": "proxymapper",
        "EnableTranslateH1ToH2": true,
        "DisableDowngradeToHttp1ForCache": false,
        "EnableDowngradeToHttp1ForOverwrittenHost": false
    },
    "SslClientOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "CheckCertificateRevocation": true,
        "ApplicationProtocols": "http/1.1,h2",
        "TlsClientType": "Native"
    },
    "SslServerOptions": {
        "EnabledSslProtocols": "Tls12,Tls13",
        "ClientCertificateRequired": false,
        "CheckCertificateRevocation": true,
        "ApplicationProtocols": "http/1.1,h2",
        "CACertificate": {
            "StoreLocation": "CurrentUser",
            "StoreName": "Root",
            "Subject": "CN=DO_NOT_TRUST_ProxyMapRoot"
        }
    },
    "Cache": {
        "Enabled": true,
        "DbPath": "c:\\temp\\debug-cache\\proxymap.db",
        "CacheDir": "c:\\temp\\debug-cache\\files"
    }
}